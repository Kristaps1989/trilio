# Copy to .env.local and fill in. Never commit .env.local.

# PostgreSQL connection string (Neon/Supabase in production, local in dev/CI).
DATABASE_URL=postgres://trilio:trilio@localhost:5432/trilio

# Shared secret for cron routes (/api/cron/*). Generate with: openssl rand -hex 32
CRON_SECRET=

# Scheduled ingestion inside the web service (docs/DEPLOY_RAILWAY.md §5). Default: on only when
# RAILWAY_ENVIRONMENT_NAME=production. Set off when a separate cron service runs `npm run ingest -- all`.
INGEST_SCHEDULE=

# Market served by this deployment: LV (default), LT or EE. Decides stores, holidays and UI language (docs/LOCALES.md).
MARKET=LV

# Electricity price used for 10-year energy cost, in cents per kWh (default 25 = 0,25 €/kWh).
ENERGY_PRICE_CENTS_PER_KWH=25

# Claude API (see docs/LLM.md). Used only for free-text routing and feed attribute extraction;
# ranking and prices never touch the model.
ANTHROPIC_API_KEY=
# Model for both purposes (default claude-haiku-5-5, the cheapest; spec tables need no more).
# Set the same value on every service that has ANTHROPIC_API_KEY (web and the cron service).
LLM_MODEL=claude-haiku-5-5
# Hard cap on calls per purpose per UTC day, counted across all services (default 300);
# exceeding it degrades gracefully (regex routing / extraction waits for tomorrow).
LLM_DAILY_CALL_CAP=300
# Prompt-cache lifetime for the free-text routing prompt: 5m (default) or 1h. Only worth 1h when
# several free-text requests arrive 5–60 minutes apart (docs/PROMPT_CACHING_PLAN.md).
LLM_CACHE_TTL=5m

# EU energy-label database (EPREL) API key, sent as X-Api-Key. Enables lookups by brand and model;
# lookups by EAN work without it. Set on the web service, whose scheduler runs the lookups (docs/ATTRIBUTES.md).
EPREL_API_KEY=

# Feature flags: 1 to enable.
FEATURE_FREE_TEXT_LLM=0
FEATURE_LLM_EXTRACT=0
FEATURE_RADAR=0

# Company details shown on the legal pages (/kontakti, /noteikumi, /privatums) and on Trilio's
# invoices. Set COMPANY_VAT_NO only once VAT-registered: invoices then show 21 % VAT.
COMPANY_NAME=
COMPANY_REG_NO=
COMPANY_VAT_NO=
COMPANY_ADDRESS=
COMPANY_EMAIL=info@trilio.lv

# Google Analytics 4 measurement id (G-XXXXXXX). Loads only after the visitor
# accepts in the consent banner. Leave empty to turn analytics off. docs/ANALYTICS.md
GA_MEASUREMENT_ID=

# Public base URL of the app (redirect/callback URLs for payments and auth).
APP_URL=http://localhost:3000

# Google Search Console verification token (the content of the HTML meta tag). Optional.
GOOGLE_SITE_VERIFICATION=
# Paysera site check meta tag (public). The current token is the default in src/app/layout.tsx; set only to replace it.
PAYSERA_SITE_VERIFICATION=

# Payments — Paysera Checkout, one-off payments for personal offers (project must be approved by Paysera).
# Credentials come from support@paysera.com after approval. See docs/PAYMENTS.md.
PAYSERA_MAC_ID=
PAYSERA_MAC_KEY=
PAYSERA_BUSINESS_ID=
# Without Paysera credentials, "mock" enables a fake checkout for development and CI.
PAYMENTS_PROVIDER=mock
# AES-256-GCM key for recurring billing tokens at rest. Generate with: openssl rand -hex 32
PAYMENT_TOKEN_KEY=

# Auth.js. Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Providers are enabled only when their credentials are set. Setup: docs/AUTH_SETUP.md
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email magic link (Resend) — also used for radar notifications and receipts.
RESEND_API_KEY=
EMAIL_FROM=Trilio <noreply@trilio.lv>
# Development/CI only. Both the dev login and the mock payments also require
# ALLOW_INSECURE_TEST_FEATURES=1. NEVER set that on a real deployment.
AUTH_DEV_LOGIN=0
ALLOW_INSECURE_TEST_FEATURES=0

# Admin section (docs/ADMIN_AND_OFFERS_PLAN.md): who may open /admin, comma-separated.
# Empty = nobody. Set on the web service only.
ADMIN_EMAILS=
# A person's name offer e-mails are signed with ("Kristaps, Trilio"). Empty = "Trilio komanda".
OFFERS_SENDER_NAME=
# Omniva's public parcel-locker list for checkout (default https://www.omniva.ee/locations.json).
OMNIVA_LOCATIONS_URL=
# Optional: Omniva business API for automatic delivery tracking (developer.omniva.ee, "Track and
# Trace"; credentials from your Omniva account manager). Without them the admin or the buyer marks delivery.
OMNIVA_API_URL=
OMNIVA_USERNAME=
OMNIVA_PASSWORD=
OMNIVA_INTEGRATION_AGENT_ID=
# Omniva event codes that mean "delivered", comma-separated (ask integrations@omniva.ee); until set,
# the event name is matched.
OMNIVA_DELIVERED_EVENT_CODES=

# Phase 2 — Web push (VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:info@trilio.lv
VAPID_SUBJECT=

# Paid traffic (docs/GROWTH_PLAN.md). Off unless FEATURE_ADS=1. ADS_PROVIDER=mock runs the
# whole admin section and the daily optimiser against a fake account (tests, local runs).
FEATURE_ADS=0
ADS_PROVIDER=

# Facebook and Instagram posts (docs/SOCIAL_PLAN.md). Off unless FEATURE_SOCIAL=1.
# SOCIAL_PROVIDER=mock posts to a fake Meta (tests, local runs). The rest comes from
# Meta Business Manager: the page id, the Instagram business account id and a
# system-user token with pages_manage_posts, pages_read_engagement, pages_show_list,
# instagram_basic, instagram_content_publish, instagram_manage_insights.
FEATURE_SOCIAL=0
SOCIAL_PROVIDER=
META_PAGE_ID=
META_IG_USER_ID=
META_SYSTEM_USER_TOKEN=
# Graph API version (default v23.0).
META_GRAPH_VERSION=
# Google Ads API access belongs to the Google Cloud project (docs/ADS_SETUP.md). Preferred:
# the project's service account JSON key (the JSON itself or base64 of it). Its e-mail is a
# user in Google Ads and an owner in Search Console.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_ADS_CUSTOMER_ID=
# Only when the account is reached through a manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Alternative to the service account: an OAuth client + refresh token of a person with access
# (scopes adwords and webmasters.readonly).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Retired by Google on 9 Sep 2026; leave empty.
GOOGLE_ADS_DEVELOPER_TOKEN=
# API version path segment (default v26); check Google's sunset dates before changing it.
GOOGLE_ADS_API_VERSION=
# Google Ads tag (Google Ads → Goals → Conversions → Google tag), e.g. AW-18535248572. Loaded only
# after cookie consent, like GA4. Conversion labels (the part after "/" in send_to) for a shop
# click and a save; empty = the tag counts visits only.
GOOGLE_ADS_TAG_ID=
GOOGLE_ADS_CONVERSION_SHOP_CLICK=
GOOGLE_ADS_CONVERSION_SAVE=
# Search Console property, e.g. sc-domain:trilio.lv (read with the same Google credentials).
SEARCH_CONSOLE_SITE=
